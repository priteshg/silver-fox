# dependencies
node_modules/

# Expo
.expo/
dist/
e2e-dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Playwright — holds a real (test) session token and run artifacts
/e2e/.auth/
/test-results/
/playwright-report/
/e2e/report/

# playwright-bdd — generated spec files from e2e/features/*.feature, rebuilt
# by `bddgen` before every run; not source, do not hand-edit or commit.
/e2e/.features-gen/
