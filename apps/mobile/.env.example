# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard, or `supabase status`
# for a local `supabase start` instance).
#
# The EXPO_PUBLIC_ prefix is required for Expo to expose these to the app —
# see https://docs.expo.dev/guides/environment-variables/. The anon key is
# safe to ship in the client: it identifies the project, not a user, and
# every table it can touch is governed by Row Level Security (see
# supabase/migrations). Never put the service_role key in this file or
# anywhere client-side — it bypasses RLS entirely.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
