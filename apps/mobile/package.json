{
  "name": "@silver-fox/mobile",
  "version": "0.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@silver-fox/config": "workspace:*",
    "@silver-fox/domain": "workspace:*",
    "@silver-fox/types": "workspace:*",
    "@silver-fox/ui": "workspace:*",
    "@silver-fox/validation": "workspace:*",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.24",
    "expo-constants": "57.0.19",
    "expo-haptics": "~57.0.3",
    "expo-linking": "57.0.10",
    "expo-router": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.47.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "~19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "babel-preset-expo": "~57.0.12",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jsdom": "30.1.0",
    "serve": "^14.2.6",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build:e2e-web": "expo export -p web --output-dir e2e-dist",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:e2e:typecheck": "tsc -p e2e/tsconfig.json",
    "test:e2e:report": "tsx e2e/support/generateReport.ts",
    "generate-seed": "tsx scripts/generateSeedSql.ts"
  },
  "private": true
}
